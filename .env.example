# ==============================================================================
# VIBE TRADING AI — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Backend API Server Configuration
API_HOST=127.0.0.1
API_PORT=8000
ENVIRONMENT=development
DEBUG=true

# Database Configuration (Local-first SQLite)
DATABASE_URL=sqlite:///./vibe_trader.db

# Local Ollama AI Configuration (Zero Subscription Cost)
# Default model: deepseek-r1:1.5b (Runs efficiently on standard laptop CPU/GPU)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=deepseek-r1:1.5b
OLLAMA_TIMEOUT_SECONDS=30.0

# Broker Integration — Zerodha Kite Connect Personal (Free)
# Used solely for authentication and margins verification.
# LIVE BROKER ORDER EXECUTION IS STRICTLY DISABLED (HTTP 403 FAIL-CLOSED).
ZERODHA_API_KEY=your_kite_api_key_here
ZERODHA_API_SECRET=your_kite_api_secret_here
ZERODHA_REDIRECT_URL=http://127.0.0.1:8000/api/broker/zerodha/callback

# Demo Risk Management Calibration (Indian Markets - NSE Equities)
SIMULATED_INITIAL_BALANCE=2000.00
MAX_RISK_PER_TRADE_PCT=0.5
MAX_DAILY_LOSS=40.00
MAX_OPEN_POSITIONS=1
MAX_POSITION_SIZE_PCT=20.0
FAIL_CLOSED_LIVE_EXECUTION=true
# Recent news via the local Ollama daemon's signed-in web-search proxy.
NEWS_PROVIDER=ollama_local
# Only for NEWS_PROVIDER=ollama_hosted (never use VITE_ for this key).
NEWS_API_KEY=
NEWS_TIMEOUT_SECONDS=8
NEWS_RETRIES=1
NEWS_CACHE_TTL_SECONDS=120
NEWS_MAX_AGE_HOURS=72
NEWS_MAX_ARTICLES=3
